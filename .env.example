# Environment Variables for BookSaver TikTok Book Finder
# Copy this file to .env and fill in your actual values

# Gemini API Key (Required for video processing)
# Get from: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Redis URL (Optional for local development)
# Production: Set by Render Redis addon
# Local: Use memory:// for in-memory cache, or redis://localhost:6379 for local Redis
REDIS_URL=memory://

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Google Books API Key (Optional - for enhanced book search)
GOOGLE_BOOKS_KEY=your_google_books_api_key_here

# Port (Optional - defaults handled in code)
PORT=5000