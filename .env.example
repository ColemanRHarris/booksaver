# Environment Variables for BookSaver
# Copy this file to .env and fill in your actual values

# Gemini API Key (Required for image processing)
# Get from: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Debug Configuration
# Set to 'true' to show technical errors even in production (for debugging)
DEBUG_ERRORS=false

# Google Books API Key (Optional - for enhanced book search)
GOOGLE_BOOKS_KEY=your_google_books_api_key_here

# Port (Optional - defaults to 5000)
PORT=5000