# Environment Variables for BookSaver
# Copy this file to .env and fill in your actual values

# Gemini API Key (Required for image processing)
# Get from: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
MAGIC_LINK_SECRET=your-magic-link-secret-here
FLASK_ENV=development
FLASK_DEBUG=1

# Debug Configuration
# Set to 'true' to show technical errors even in production (for debugging)
DEBUG_ERRORS=false

# Google Books API Key (Optional - for enhanced book search)
GOOGLE_BOOKS_KEY=your_google_books_api_key_here

# Email (magic-link login) - set one provider
SENDGRID_API_KEY=your_sendgrid_api_key_here
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here

# Stripe (Optional - for Pro subscription/pay-per-scan billing)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# App URL (used in magic-link emails)
APP_URL=http://localhost:5000

# Port (Optional - defaults to 5000)
PORT=5000