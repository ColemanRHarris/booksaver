# Environment Variables for BookSaver TikTok Book Finder
# Copy this file to .env and fill in your actual values

# Gemini API Key (Required for video processing)
# Get from: https://console.cloud.google.com/apis/credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Redis URL (Optional for local development)
# Production: Set by Render Redis addon automatically
# Local Options:
#   - Leave empty/unset for full in-memory storage (easiest for testing)
#   - Use redis://localhost:6379 if you have Redis server running locally
#   - Set LOCAL_TESTING=true to force in-memory mode regardless of Redis availability
REDIS_URL=

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Local Testing Mode (Optional)
# Set to true to force in-memory storage for all services during local development
# Bypasses all Redis connections and uses local storage/memory
LOCAL_TESTING=true

# Google Books API Key (Optional - for enhanced book search)
GOOGLE_BOOKS_KEY=your_google_books_api_key_here

# Stripe Configuration (Required for subscription features)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_endpoint_secret_here

# Gmail SMTP Configuration (Required for password reset)
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to Google Account Settings → Security → 2-Step Verification → App passwords
# 3. Generate an App password for "Mail"
# 4. Use that 16-character app password below (not your regular Gmail password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail@gmail.com
SMTP_PASSWORD=your_16_character_app_password_here
FROM_EMAIL=your_gmail@gmail.com

# Port (Optional - defaults handled in code)
PORT=5000